# === Обязательно для бота ===
BOT_TOKEN=
ADMIN_ID=
# alias (рекомендуется для облака)
OWNER_TELEGRAM_ID=
CHANNEL_ID=

# === Необязательно ===
TIMEZONE=Europe/Moscow
OPENAI_API_KEY=

# === Облако и синхронизация (Supabase) ===
# file | supabase | dual
STORAGE_BACKEND=file
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SYNC_ENABLED=false
HEALTH_PORT=8080
INSTANCE_ID=

# === Telegram updates (prod: webhook, local: polling) ===
# polling | webhook — или не задавайте BOT_MODE: при WEBHOOK_URL включится webhook
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# === Только для npm run import:channel / reconcile (GramJS) ===
TG_API_ID=
TG_API_HASH=
TG_SESSION=
